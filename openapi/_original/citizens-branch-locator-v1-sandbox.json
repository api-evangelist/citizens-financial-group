        },
        "branch": {
          "$ref": "#/definitions/Branch"
        }
      }
    },
    "DriveupWindowHour": {
      "type": "object",
      "properties": {
        "dayOfWeek": {
          "type": "string"
        },
        "openingTime": {
          "type": "string"
        },
        "closingTime": {
          "type": "string"
        }
      }
    },
    "GetLocationsResponse": {

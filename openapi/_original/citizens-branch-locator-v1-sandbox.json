        },
        "postalCode": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "Branch": {
      "type": "object",
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operatingHours": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OperatingHour"
          }
        },
        "driveupWindowHours": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DriveupWindowHour"
          }
        }
      }
    },
    "BranchDetails": {
      "type": "object",
      "properties": {
        "locationNumber": {
          "type": "string"
        },
        "locationName": {
          "type": "string"
        },
        "phoneNumber": {
          "type": "string"
        },
        "latitude": {
          "type": "integer",
          "format": "int32"
        },
        "longitude": {
          "type": "integer",
          "format": "int32"
        },
        "cashDenomination": {
          "type": "string"
        },
        "routingNumber": {
          "type": "string"
        },
        "address": {

    "OperatingHour": {
      "type": "object",
      "properties": {
        "dayOfWeek": {
          "type": "string"
        },
        "openingTime": {
          "type": "string"
        },
        "closingTime": {
          "type": "string"
        }
      }
    },
    "Brand": {
      "type": "object",
      "properties": {
        "BrandName": {
          "type": "string"
        },
        "Branch": {
          "type": "array",
